{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "outputDirectory": "public",

  "buildCommand": "",
  "installCommand": "",

  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },

  "rewrites": [
    { "source": "/du", "destination": "/home.html" },
    { "source": "/du/", "destination": "/home.html" },
    { "source": "/du/:path*", "destination": "/:path*" },
    { "source": "/rw", "destination": "/home.html" },
    { "source": "/rw/", "destination": "/home.html" },
    { "source": "/rw/:path*", "destination": "/:path*" }
  ]
}
