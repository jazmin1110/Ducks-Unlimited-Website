{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "outputDirectory": "public",

  "buildCommand": "",
  "installCommand": "",

  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },

  "redirects": [
    { "source": "/gift-cards.html", "destination": "/shop.html", "permanent": false },
    { "source": "/:brand(du|rw)/gift-cards.html", "destination": "/:brand/shop.html", "permanent": false }
  ],

  "rewrites": [
    { "source": "/go/ducks", "destination": "/go/ducks.html" },
    { "source": "/go/ducks-gh", "destination": "/go/ducks.html" },
    { "source": "/go/ducks-cph", "destination": "/go/ducks.html" },
    { "source": "/go/rocwood", "destination": "/go/rocwood.html" },
    { "source": "/go/rocwood-gh", "destination": "/go/rocwood.html" },
    { "source": "/go/rocwood-cph", "destination": "/go/rocwood.html" },
    { "source": "/du", "destination": "/home.html" },
    { "source": "/du/", "destination": "/home.html" },
    { "source": "/du/:path*", "destination": "/:path*" },
    { "source": "/rw", "destination": "/home.html" },
    { "source": "/rw/", "destination": "/home.html" },
    { "source": "/rw/:path*", "destination": "/:path*" }
  ]
}
